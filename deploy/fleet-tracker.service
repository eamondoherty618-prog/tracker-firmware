[Unit]
Description=Fleet Tracker Prototype Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eamondoherty618
WorkingDirectory=/home/eamondoherty618/fleet-tracker
ExecStart=/usr/bin/python3 /home/eamondoherty618/fleet-tracker/server/fleet_server.py --host 127.0.0.1 --port 8081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
